# ============================================
# Signal Daily Digest — Environment Variables
# ============================================
# Copy to .env and fill in real values:
#   cp .env.example .env

# Anthropic API Key (Claude Sonnet for insight generation)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Resend API Key (email delivery)
# https://resend.com/api-keys
RESEND_API_KEY=

# Recipient email address for the daily digest
DIGEST_EMAIL=

# Auth token for the /run-digest endpoint (used by cron-job.org)
CRON_SECRET=

# Base URL for article reader links in emails
APP_URL=http://100.99.202.60:3001
